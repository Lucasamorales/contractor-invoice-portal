# Copy to .env for local development. Never commit the real file.
# Production and staging read these from Secret Manager (R-SEC-02).

PORTAL_ENVIRONMENT=staging

# Cloud IAP (R-ACC-02). The audience of the signed assertion, of the form
# /projects/<project-number>/global/backendServices/<backend-service-id>.
PORTAL_IAP_AUDIENCE=
PORTAL_WORKSPACE_DOMAIN=example.com

# The finance group, comma separated (R-ACC-04). Checked in the app as well as
# at IAP.
PORTAL_FINANCE_EMAILS=

# Postgres, pooled endpoint. Production must set sslmode=verify-full
# (R-SEC-07), and verify-full needs a CA to verify against: sslrootcert=system
# on Cloud Run, the path from `python -c "import certifi; print(certifi.where())"`
# on Windows, where libpq's OpenSSL has no default store.
PORTAL_DATABASE_URL=postgresql+psycopg://user:password@host-pooler/dbname?sslmode=verify-full&sslrootcert=system&channel_binding=require

# The same database on its direct endpoint (no -pooler). Alembic prefers this:
# DDL through PgBouncer's transaction pooling is not something to rely on.
PORTAL_MIGRATION_URL=postgresql+psycopg://user:password@host/dbname?sslmode=verify-full&sslrootcert=system&channel_binding=require

# AES-256 key for the bank columns, base64 (R-SEC-03). Generate one with:
#   uv run python -c "from app.services.crypto import generate_key; print(generate_key())"
# Store it in Secret Manager. Losing it means losing every stored bank detail.
PORTAL_BANK_ENCRYPTION_KEY=
PORTAL_BANK_ENCRYPTION_KEY_ID=v1

# 1 kudo = £20 (R-KUD-04).
PORTAL_KUDOS_RATE_PENCE=2000

# Cloud Scheduler (R-JOB-*). Both are required before /tasks/* will run.
PORTAL_SCHEDULER_AUDIENCE=
PORTAL_SCHEDULER_SERVICE_ACCOUNT=

# CSRF token signing (R-SEC-11). Any long random string.
PORTAL_CSRF_SECRET=

# Storage, mail and the kudos sheet. Not needed until build order step 6.
PORTAL_GCS_BUCKET=
PORTAL_KUDOS_SHEET_ID=
PORTAL_POSTMARK_TOKEN=
PORTAL_MAIL_FROM=
PORTAL_FINANCE_INBOX=
PORTAL_DRIVE_FOLDER_ID=
