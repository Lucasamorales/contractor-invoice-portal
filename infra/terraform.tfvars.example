# The shape of an environment's settings. The real ones, staging.tfvars and
# production.tfvars, are committed: they hold no secret.

project_id  = "your-gcp-project"
environment = "staging"
region      = "europe-west2"

# Pin a tag or digest. Never :latest.
image = "europe-west2-docker.pkg.dev/your-gcp-project/portal/invoice-portal:0.1.0"

# CLAUDE.md §2.1: the only people who may see fees.
finance_emails = [
  "julian@example.com",   # Robin
  "charlie@example.com",  # Charlie
  "remy@example.com",  # Remy
]

# Who may get through IAP at all. For staging this should be the developers
# only (R-ENV-04); for production, everyone who invoices.
iap_members = [
  "user:leo@example.com",
]

# Staging only. Forces the submission window open for testing; production
# refuses to start with it set.
window_always_open = false
