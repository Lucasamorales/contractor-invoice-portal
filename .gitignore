# Real bank details and fees live here. Never committed. (CLAUDE.md §7)
data/*
*.xlsx

# Robin's blank template carries only XXXXX placeholders, and R-PDF-13 needs it
# committed as the visual reference for the regression test.
!data/invoice-template.pdf

# Secrets
.env
.env.*
!.env.example
*.pem
*-key.json

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# The two environments' settings hold no secret and are reviewed like code.
!infra/staging.tfvars
!infra/production.tfvars

# Rendered output from local runs
/out/
